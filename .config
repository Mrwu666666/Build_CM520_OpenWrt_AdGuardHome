
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_mercury_cm520-79f=y

# 基础系统设置

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y

# 去除MMC/SD卡支持 (节省空间，避免星际宝盒无SD槽导致的报错)

# CONFIG_PACKAGE_kmod-mmc is not set

# CONFIG_PACKAGE_kmod-sdhci is not set

# CONFIG_PACKAGE_kmod-sdhci-ipq40xx is not set

# CONFIG_KERNEL_MMC is not set

# 网络设置 - WAN口默认DHCP (自动获取IP)

# CONFIG_PACKAGE_ppp is not set (如果不需PPPoE可去除，但建议保留以防万一)

CONFIG_PACKAGE_luci-proto-ppp=y

# 去广告插件 Adbyby Plus

CONFIG_PACKAGE_luci-app-adbyby-plus=y
CONFIG_PACKAGE_adbyby-plus=y

# 必要的Luci界面

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-adbyby-plus-zh-cn=y

# 其他常用优化 (可选)

CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_coremark=y
